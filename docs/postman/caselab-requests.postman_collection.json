      "item": [
        {
          "name": "Список оборудования",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/equipment?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment"],
              "query": [

            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Отправляет 120 запросов подряд и проверяет, что после этого лимит исчерпан. Запускать последним: расходует квоту на окно. Default-лимит — RATE_LIMIT_MAX (100)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const url = '{{baseUrl}}/api/health';",
                  "let sent = 0;",
                  "function flood(cb) {",
                  "  if (sent >= 120) { cb(); return; }",
                  "  sent++;",
                  "  pm.sendRequest(url, () => flood(cb));",
                  "}",
                  "flood(() => {",
                  "  pm.sendRequest(url, (err, res) => {",
                  "    pm.test('код ответа 429 при превышении лимита', () => {",
                  "      pm.expect(err).to.eql(null);",
                  "      pm.expect(res).to.have.property('code', 429);",
                  "    });",
                  "    pm.test('ошибка в едином формате', () => {",
                  "      pm.expect(res.json().error.code).to.equal('RATE_LIMIT_EXCEEDED');",
                  "    });",
                  "  });",
                  "});"
                ]
              }
            }
          ]

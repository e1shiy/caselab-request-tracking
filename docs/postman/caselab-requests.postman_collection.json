{
  "info": {
    "_postman_id": "3f2d1c44-7a3e-4f08-9c62-0b91c9e5a7d1",
    "name": "CaseLab Requests API",
    "description": "Коллекция для сервиса учёта заявок на обслуживание оборудования. Перед запуском создайте окружение с переменной baseUrl (например http://localhost:3000). Запускайте по группам: сначала Equipment, затем Requests. Идентификаторы созданных сущностей передаются между запросами через переменные коллекции. Фикстуры (SN-001, SN-003) фиксированы, поэтому полный прогон выполняйте на чистом DATA_DIR — иначе создание оборудования вернёт 409 по дубликату серийного номера. Последний запрос расходует лимит частоты и должен идти последним. Для проверки теста 429 в переменных коллекции есть rateLimitMax (по умолчанию 100) — увеличьте его, если на сервере задан другой RATE_LIMIT_MAX.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Equipment (справочник оборудования)",
      "item": [
        {
          "name": "Список оборудования",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/equipment?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            },
            "description": "Список с пагинацией и метаданными total/page/limit"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('код ответа 200', () => pm.response.to.have.status(200));",
                  "pm.test('структура списка { data, meta }', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.be.an('object');",
                  "  pm.expect(body.data).to.be.an('array');",
                  "  pm.expect(body.meta).to.be.an('object');",
                  "  pm.expect(body.meta).to.have.property('total');",
                  "  pm.expect(body.meta).to.have.property('page');",
                  "  pm.expect(body.meta).to.have.property('limit');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Создание оборудования",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ветрогенератор W-01\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"SN-001\",\n  \"location\": { \"lat\": 54.35, \"lon\": 37.61 },\n  \"installedAt\": \"2024-05-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/equipment",
              "host": ["{{baseUrl}}"],
              "path": ["api", "equipment"]
            },
            "description": "Создание записи; id сохраняется в переменную equipmentId"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('код ответа 201 и Location', () => {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.headers.get('Location')).to.match(/\\/api\\/equipment\\//);",
                  "});",
                  "const equipment = pm.response.json();",
                  "pm.collectionVariables.set('equipmentId', equipment.id);",
                  "pm.test('структура оборудования', () => {",
                  "  pm.expect(equipment.id).to.be.a('string');",
                  "  pm.expect(equipment.name).to.equal('Ветрогенератор W-01');",
                  "  pm.expect(equipment.serialNumber).to.equal('SN-001');",
                  "  pm.expect(equipment.status).to.equal('operational');",
                  "  pm.expect(equipment.location).to.have.property('lat');",
                  "  pm.expect(equipment).to.have.property('createdAt');",
                  "  pm.expect(equipment).to.have.property('updatedAt');",
                  "});"
                ]
              }
            }
          ]
        },

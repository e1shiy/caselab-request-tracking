        {
          "name": "Превышение лимита частоты (ожидаем 429)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": ["{{baseUrl}}"],
              "path": ["api", "health"]
            },
            "description": "Отправляет запросы по кругу до первого 429 и проверяет, что лимит исчерпан. Запускать последним: расходует квоту на окно. Если RATE_LIMIT_MAX изменён в окружении сервера, увеличьте rateLimitMax в переменных коллекции."
          },
          "event": [
              {
                "listen": "test",
                "script": {
                  "type": "text/javascript",
                  "exec": [
                    "const url = pm.variables.replaceIn('{{baseUrl}}/api/health');",
                    "const maxRequests = Number(pm.collectionVariables.get('rateLimitMax')) + 50;",
                    "let sent = 0;",
                    "let limited = null;",
                    "let failure = null;",
                    "",
                    "function flood(cb) {",
                    "  if (limited !== null || failure !== null || sent >= maxRequests) { cb(); return; }",
                    "  sent++;",
                    "  pm.sendRequest(url, (err, res) => {",
                    "    if (err) { failure = err; return cb(); }",
                    "    if (res.code === 429) { limited = res; return cb(); }",
                    "    flood(cb);",
                    "  });",
                    "}",
                    "",
                    "flood(() => {",
                    "  pm.test('лимит частоты исчерпан, получен 429', () => {",
                    "    pm.expect(failure, 'запрос не выполнился').to.eql(null);",
                    "    pm.expect(limited, 'ожидался 429, но все ' + sent + ' запросов прошли').to.not.eql(null);",
                    "    pm.expect(limited.code).to.eql(429);",
                    "  });",
                    "  pm.test('ответ 429 в едином формате ошибки', () => {",
                    "    if (limited === null) return;",
                    "    const body = limited.json();",
                    "    pm.expect(body.error.code).to.equal('RATE_LIMIT_EXCEEDED');",
                    "    pm.expect(body.error.message).to.be.a('string');",
                    "    pm.expect(body.error.requestId).to.be.a('string');",
                    "  });",
                    "  pm.test('присутствуют заголовки RateLimit-*', () => {",
                    "    if (limited === null) return;",
                    "    pm.expect(limited.headers.get('RateLimit-Limit'), 'заголовок RateLimit-Limit').to.be.a('string');",
                    "  });",
                    "});"
                  ]
                }
              }
            ]
        }

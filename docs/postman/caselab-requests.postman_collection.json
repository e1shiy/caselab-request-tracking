            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ветрогенератор W-01\",\n  \"type\": \"turbine\",\n  \"serialNumber\": \"SN-001\",\n  \"location\": { \"lat\": 54.35, \"lon\": 37.61 },\n  \"installedAt\": \"2024-05-01\"\n}"

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Swagger UI и спецификация OpenAPI
DOCS_ENABLED=true

# Ограничение частоты запросов
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
BODY_LIMIT=100kb
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
REQUEST_TIMEOUT_MS=5000
WEATHER_FORECAST_DAYS=5
WEATHER_MAX_WIND_KMPH=15
WEATHER_ALLOWED_PRECIPITATION_MM=0

# База данных. Те же значения использует compose.yaml: он подставляет
# DB_NAME/DB_USER/DB_PASSWORD как POSTGRES_DB/APP_DB_*.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=app_rw
DB_PASSWORD=change_me_locally
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000
DB_POOL_ACQUIRE_MS=5000
DB_LOG_QUERIES=false
DB_CONNECT_RETRIES=10
DB_RETRY_BASE_DELAY_MS=500

# Роль с правом менять схему: только для npm run db:migrate и db:seed.
# В compose.yaml она же создаёт кластер (POSTGRES_USER).
DB_MIGRATION_USER=postgres
DB_MIGRATION_PASSWORD=postgres

# Обратный прокси. Значение 1 соответствует одному nginx перед приложением:
# тогда X-Forwarded-For и X-Forwarded.Proto от него считаются доверенными.
TRUST_PROXY_HOPS=1

# Секреты подписи JWT. В production обязательны: не короче 32 символов и
# разные значения для access и refresh. Сгенерировать:
#   openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=604800

# Пароли: bcrypt, стоимость по умолчанию 12.
BCRYPT_ROUNDS=12

# Refresh-токен хранится в HttpOnly-cookie. Secure берётся из NODE_ENV,
# если значение не задано явно.
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_SECURE=
COOKIE_SAME_SITE=lax

# Отдельный лимит для POST /api/auth/login на пару «IP + email».
LOGIN_RATE_LIMIT_WINDOW_MS=300000
LOGIN_RATE_LIMIT_MAX=10

# Демо-пользователи для npm run db:seed. Пароли остаются только в .env,
# в репозитории их быть не должно. Аккаунт без пароля пропускается.
SEED_USERS=false
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=
SEED_TECHNICIAN_EMAIL=technician@example.test
SEED_TECHNICIAN_PASSWORD=
SEED_VIEWER_EMAIL=viewer@example.test
SEED_VIEWER_PASSWORD=

NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
BODY_LIMIT=100kb
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
REQUEST_TIMEOUT_MS=5000
WEATHER_FORECAST_DAYS=5
WEATHER_MAX_WIND_KMPH=15
WEATHER_ALLOWED_PRECIPITATION_MM=0

# База данных. Те же значения использует compose.yaml: он подставляет
# DB_NAME/DB_USER/DB_PASSWORD как POSTGRES_DB/APP_DB_*.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appdb
DB_USER=app_rw
DB_PASSWORD=change_me_locally
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000
DB_POOL_ACQUIRE_MS=5000
DB_LOG_QUERIES=false
DB_CONNECT_RETRIES=10
DB_RETRY_BASE_DELAY_MS=500

# Роль с правом менять схему: только для npm run db:migrate и db:seed.
# В compose.yaml она же создаёт кластер (POSTGRES_USER).
DB_MIGRATION_USER=postgres
DB_MIGRATION_PASSWORD=postgres

# Значение по умолчанию для полей author / changed_by.
DEFAULT_AUTHOR=system
